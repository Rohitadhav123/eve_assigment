generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./test.db"
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("USER")
  createdAt    DateTime  @default(now())
  bookings     Booking[]
}

model DiagnosticCentre {
  id          String       @id @default(uuid())
  name        String
  location    String
  createdAt   DateTime     @default(now())
  centreTests CentreTest[]
}

model DiagnosticTest {
  id          String       @id @default(uuid())
  name        String       @unique
  description String
  createdAt   DateTime     @default(now())
  centreTests CentreTest[]
}

model CentreTest {
  id        String           @id @default(uuid())
  centreId  String
  testId    String
  price     Float
  createdAt DateTime         @default(now())
  centre    DiagnosticCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)
  test      DiagnosticTest   @relation(fields: [testId], references: [id], onDelete: Cascade)
  bookings  Booking[]

  @@unique([centreId, testId])
}

model Booking {
  id            String     @id @default(uuid())
  userId        String
  centreTestId  String
  appointmentAt DateTime
  amount        Float
  status        String     @default("PENDING")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  centreTest    CentreTest @relation(fields: [centreTestId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@unique([centreTestId, appointmentAt])
}

model Payment {
  id                    String   @id @default(uuid())
  bookingId             String
  amount                Float
  status                String   @default("INITIATED")
  providerTransactionId String?  @unique
  idempotencyKey        String?  @unique
  createdAt             DateTime @default(now())
  booking               Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  type        String
  payload     String
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}
